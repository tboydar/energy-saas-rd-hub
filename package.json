{
  "name": "energy-saas-rd-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Energy SaaS 研發管理中心 — 純前端作品集 Demo（全部為虛構資料）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run test",
    "check:names": "bun scripts/check-names.ts"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@xyflow/react": "^13.0.2",
    "chart.js": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
